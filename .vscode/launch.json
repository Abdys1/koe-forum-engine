{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: dev (watch)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "watch:dev"],
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/backend/node_modules/**"]
    },
    {
      "name": "Backend: dev (no watch)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/backend",
      "runtimeExecutable": "${workspaceFolder}/backend/node_modules/.bin/tsx",
      "program": "${workspaceFolder}/backend/src/bin/www.ts",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/backend/node_modules/**"]
    },
    {
      "name": "Frontend: Next.js dev",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/frontend/node_modules/**"],
      "serverReadyAction": {
        "pattern": "- Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ],
  "compounds": [
    {
      "name": "Full stack: backend + frontend (dev)",
      "configurations": ["Backend: dev (watch)", "Frontend: Next.js dev"],
      "stopAll": true,
      "presentation": {
        "group": "1_fullstack",
        "order": 1
      }
    }
  ]
}
