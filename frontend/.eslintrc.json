{
  "extends": [
    "next/core-web-vitals",
    "plugin:storybook/recommended"
  ],
  "plugins": [
    "simple-import-sort",
    "boundaries"
  ],
  "settings": {
    "boundaries/include": [
      "src/**/*"
    ],
    "boundaries/elements": [
      {
        "type": "atom",
        "pattern": "src/components/atoms/*"
      },
      {
        "type": "molecule",
        "pattern": "src/components/molecules/*"
      },
      {
        "type": "organism",
        "pattern": "src/components/organisms/*/*"
      },
      {
        "type": "template",
        "pattern": "src/components/templates/*"
      },
      {
        "type": "feature",
        "pattern": "src/features/*"
      },
      {
        "type": "hook",
        "pattern": "src/hooks"
      },
      {
        "type": "style",
        "pattern": "src/styles"
      },
      {
        "type": "util",
        "pattern": "src/utils"
      },
      {
        "type": "lib",
        "pattern": "src/lib"
      },
      {
        "type": "app",
        "pattern": "src/app"
      },
      {
        "type": "dummydata",
        "pattern": "src/dummydata"
      }
    ],
    "boundaries/files": [
      {
        "pattern": "src/middleware.ts",
        "category": "middleware"
      },
      {
        "pattern": "**/*.stories.tsx",
        "category": "story"
      }
    ]
  },
  "rules": {
    "simple-import-sort/imports": "error",
    "simple-import-sort/exports": "error",
    "boundaries/dependencies": [
      "error",
      {
        "default": "disallow",
        "message": "A(z) {{ from.element.types.[0] }} szint nem importálhat {{ to.element.types.[0] }} szintről",
        "policies": [
          {
            "from": {
              "element": {
                "type": "atom"
              }
            },
            "allow": {
              "to": {
                "element": {
                  "types": [
                    "atom",
                    "hook",
                    "style",
                    "util"
                  ]
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": "molecule"
              }
            },
            "allow": {
              "to": {
                "element": {
                  "types": [
                    "atom",
                    "molecule",
                    "hook",
                    "style",
                    "util"
                  ]
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": "organism"
              }
            },
            "allow": {
              "to": {
                "element": {
                  "types": [
                    "atom",
                    "molecule",
                    "organism",
                    "feature",
                    "hook",
                    "style",
                    "util"
                  ]
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": "organism"
              }
            },
            "allow": {
              "to": {
                "element": {
                  "type": "lib"
                }
              },
              "dependency": {
                "kind": "type"
              }
            }
          },
          {
            "from": {
              "element": {
                "type": "template"
              }
            },
            "allow": {
              "to": {
                "element": {
                  "types": [
                    "atom",
                    "molecule",
                    "organism",
                    "hook",
                    "style",
                    "util"
                  ]
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": "template"
              }
            },
            "allow": {
              "to": {
                "element": {
                  "types": [
                    "feature",
                    "lib"
                  ]
                }
              },
              "dependency": {
                "kind": "type"
              }
            }
          },
          {
            "from": {
              "element": {
                "type": "feature"
              }
            },
            "allow": {
              "to": {
                "element": {
                  "types": [
                    "feature",
                    "lib",
                    "hook",
                    "util",
                    "dummydata"
                  ]
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": "hook"
              }
            },
            "allow": {
              "to": {
                "element": {
                  "types": [
                    "hook",
                    "util"
                  ]
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": "style"
              }
            },
            "allow": {
              "to": {
                "element": {
                  "types": [
                    "style",
                    "util"
                  ]
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": "lib"
              }
            },
            "allow": {
              "to": {
                "element": {
                  "types": [
                    "lib",
                    "util",
                    "dummydata"
                  ]
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": "util"
              }
            },
            "allow": {
              "to": {
                "element": {
                  "type": "util"
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": "dummydata"
              }
            },
            "allow": {
              "to": {
                "element": {
                  "types": [
                    "lib",
                    "util"
                  ]
                }
              },
              "dependency": {
                "kind": "type"
              }
            }
          },
          {
            "from": {
              "file": {
                "categories": "story"
              }
            },
            "allow": {
              "to": {
                "element": {
                  "type": "feature"
                },
                "file": {
                  "path": "**/__fixtures__/**"
                }
              }
            }
          },
          {
            "from": {
              "element": {
                "type": "app"
              }
            },
            "allow": {
              "to": {
                "element": {
                  "types": [
                    "atom",
                    "molecule",
                    "organism",
                    "template",
                    "feature",
                    "hook",
                    "style",
                    "lib",
                    "app",
                    "util",
                    "dummydata"
                  ]
                }
              }
            }
          }
        ]
      }
    ],
    "boundaries/no-unknown-files": "error"
  }
}
