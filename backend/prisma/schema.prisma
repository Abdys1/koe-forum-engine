// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ForumUser {
  id Int @id @default(autoincrement())
  username String @unique @db.VarChar(255)
  password String
  characters Character[] @relation("UserCharacters")
  activeCharacterId Int? @unique
  activeCharacter Character? @relation("ActiveCharacter", fields: [activeCharacterId], references: [id], onDelete: SetNull)
}

model Character {
  id Int @id @default(autoincrement())
  user ForumUser @relation("UserCharacters", fields: [userId], references: [id])
  userId Int
  activeForUser ForumUser? @relation("ActiveCharacter")
  name String @unique @db.VarChar(64)
  sex Int @db.SmallInt
  raceId Int
  race Race @relation(fields: [raceId], references: [id], onDelete: Restrict)
  imageUrl String
  equipment CharacterEquipment[]

  @@index([raceId])
}

model Race {
  id Int @id @default(autoincrement())
  name String @unique @db.VarChar(128)
  teaser String
  description String
  imageUrl String
  buttonImageUrl String
  sortOrder Int @default(0)
  createdAt DateTime @default(now())
  characters Character[]
}

model Equipment {
  id Int @id @default(autoincrement())
  name String @db.VarChar(255)
  typeId Int
  type EquipmentType @relation(fields: [typeId], references: [id])
  description String
  slotCost Int?
  characterLinks CharacterEquipment[]

  @@unique([name, typeId])
}

model EquipmentType {
  id Int @id @default(autoincrement())
  label String @unique @db.VarChar(128)
  createdAt DateTime @default(now())
  slotId Int?
  slot Slot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  parentId Int?
  parent EquipmentType? @relation("EquipmentTypeTree", fields: [parentId], references: [id], onDelete: NoAction)
  children EquipmentType[] @relation("EquipmentTypeTree")
  icon String? @db.VarChar(32)
  sortOrder Int @default(0)
  equipment Equipment[]
}

model Slot {
  id Int @id @default(autoincrement())
  label String @unique @db.VarChar(128)
  maxCapacity Int
  createdAt DateTime @default(now())
  equipmentTypes EquipmentType[]
}

model CharacterEquipment {
  id Int @id @default(autoincrement())
  characterId Int
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  equipmentId Int
  equipment Equipment @relation(fields: [equipmentId], references: [id])
  createdAt DateTime @default(now())

  @@index([characterId])
  @@index([equipmentId])
}