PORT=4000

# JWT signing secrets, use long random strings
ACCESS_TOKEN_SECRET=change-me
REFRESH_TOKEN_SECRET=change-me-too

# Dev database from config/database/docker-compose.yml
DATABASE_URL=postgresql://postgres:example@localhost:5432/postgres?schema=public

# Storage configuration
STORAGE_TYPE=local
# STORAGE_TYPE options: local | aws

# Local storage directory (used if STORAGE_TYPE=local), relative to the backend folder or absolute
LOCAL_UPLOADS_DIR=.data/uploads
# LOCAL_UPLOADS_DIR=/var/lib/koe-forum/uploads

# AWS S3 Configuration (required if STORAGE_TYPE=aws)
# AWS_REGION=us-east-1
# AWS_BUCKET_NAME=your-bucket-name
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
